# ============================================
# Query Processor — Render Dockerfile
# Unlike the local Dockerfile, Render's build environment has internet
# access, so this installs directly from PyPI instead of a pre-downloaded
# wheel_cache/ (which isn't committed to git and can't exist on a fresh clone).
# ============================================

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r requirements.txt

COPY . .

# The shared core (core/ in the repo; local push PPR, chat client). It's outside this build
# context, so it comes in as a named context:
#   docker compose: additional_contexts core: ./core (docker-compose.yml)
#   docker buildx build --build-context core=core ...
COPY --from=core graphrag_core /core/graphrag_core
ENV PYTHONPATH=/core

# Generate gRPC stubs from proto during build
RUN python -m grpc_tools.protoc -I proto --python_out=app --grpc_python_out=app proto/query.proto

EXPOSE 50051

WORKDIR /app/app
CMD ["python", "main.py"]
