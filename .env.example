# Copy to .env and fill in. Used by docker-compose.yml and docker-compose.hub.yml.
# Inside Docker, the compose files override the hosts below (minio, neo4j, milvus-standalone),
# so the localhost values only matter when running the services outside Docker.

# Docker Hub account the images are pushed to / pulled from, and the image tag
DOCKERHUB_USER=williamfaraday123
TAG=latest

# LLM: any OpenAI-compatible server; Ollama by default.
# With docker-compose.hub.yml these three models are pulled into the bundled Ollama
# container on first start (once; they stay in the ollama_data volume).
# KG_MODEL extracts the knowledge graph from uploads (and from the wiki when building its snapshot).
LLM_API_KEY=ollama
EDGE_MODEL=qwen2.5:1.5b
ANSWER_MODEL=qwen3:4b-instruct
KG_MODEL=qwen2.5:1.5b
EDGE_MODEL_BASE_URL=http://localhost:11434/v1
# Sentences sent to Ollama at once during knowledge-graph extraction. Ollama runs them
# together only up to its OLLAMA_NUM_PARALLEL (set below for the bundled container; for
# Ollama on the host, set it as an environment variable there and restart Ollama).
# Each extra slot costs memory in every loaded model: at 2, qwen3:4b-instruct takes about
# 5.1 GB instead of about 3.6 GB; at 4, about 7.5 GB.
KG_PARALLEL=2
OLLAMA_NUM_PARALLEL=2
# LLM URL the containers use. Leave unset for the default:
#   docker-compose.hub.yml -> the bundled Ollama container (http://ollama:11434/v1)
#   docker-compose.yml     -> Ollama on the host machine (http://host.docker.internal:11434/v1)
# DOCKER_EDGE_MODEL_BASE_URL=

# MinIO (Milvus also stores its data here with the default minioadmin credentials,
# so keep these unless you also configure Milvus)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=rag-datasets

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Chunking (uploads, and the wiki when its snapshot is built)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Wiki snapshot build only (docker-compose.wiki-build.yml): which WikiText files in
# ingestion_pipeline/raw_data to build, and an optional article limit (0 = all).
# Knowledge-graph extraction takes about 4 s per sentence on a CPU: wiki.test.txt
# (62 articles) takes around 10 hours.
WIKI_FILES=wiki.test.txt
WIKI_MAX_ARTICLES=0
